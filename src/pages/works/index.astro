---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSection from '../../components/CtaSection.astro';
---

<BaseLayout
  title="Works"
  description="Hank Chou 的作品集 — 網站設計、行動 App 與品牌識別設計專案展示。"
>
  <section class="container" style="padding-top: var(--space-16); padding-bottom: var(--space-16);">
    <h1 style="margin-bottom: var(--space-4);">My Works</h1>
    <div class="wip-block">
      <span class="wip-icon">🚧</span>
      <p class="wip-title">施工中</p>
      <p class="wip-desc">作品集正在整理中，敬請期待。</p>
    </div>
  </section>
  <CtaSection />
</BaseLayout>

<style>
  .wip-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-16) 0;
    border: 1.5px dashed var(--color-border);
    border-radius: 1rem;
    text-align: center;
  }
  .wip-icon { font-size: 2.5rem; }
  .wip-title { font-size: 1.25rem; font-weight: 700; color: var(--color-text); margin: 0; }
  .wip-desc { font-size: 0.9rem; color: var(--color-text-muted); margin: 0; }
</style>
