---
const base = import.meta.env.BASE_URL;

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="tag-list">
  {tags.map((tag) => (
    <a href={`${base}tags/${encodeURIComponent(tag)}`} class="tag tag-link">
      {tag}
    </a>
  ))}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-link {
    transition: background-color 0.2s, color 0.2s;
  }

  .tag-link:hover {
    background-color: var(--color-accent-orange);
    color: #fff;
  }
</style>
