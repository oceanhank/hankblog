---
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');

interface Props {
  title: string;
  coverImage: string;
  description: string;
  tags: string[];
  slug: string;
}

const { title, coverImage, description, tags, slug } = Astro.props;

const imageSrc = coverImage.startsWith('http')
  ? coverImage
  : `${base}${coverImage.replace(/^\//, '')}`;
---

<article class="work-card">
  <a href={`${base}works/${slug}`} class="work-card-link">
    <div class="work-card-image">
      <img src={imageSrc} alt={`${title} project screenshot`} loading="lazy" />
    </div>
    <div class="work-card-body">
      <h2 class="work-card-title">{title}</h2>
      <p class="work-card-desc">{description}</p>
      <div class="work-card-tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .work-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .work-card-link {
    display: block;
  }

  .work-card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--color-border);
  }

  .work-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .work-card:hover .work-card-image img {
    transform: scale(1.04);
  }

  .work-card-body {
    padding: var(--space-6);
  }

  .work-card-title {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }

  .work-card-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
