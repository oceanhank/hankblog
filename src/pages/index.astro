---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { testimonials } from '../data/testimonials';

const base = import.meta.env.BASE_URL;

const allWorks = await getCollection('works', ({ data }) => !data.draft);
const featuredWorks = allWorks
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const services = [
  { icon: '🌐', label: '網站設計', count: '30+ 專案' },
  { icon: '📱', label: '行動 App 設計', count: '15+ 專案' },
  { icon: '🎨', label: '品牌識別設計', count: '20+ 專案' },
];
---

<BaseLayout
  title="Hank Chou — Web Designer & Developer"
  description="我是 Hank Chou，專注於網站設計與開發，幫助品牌打造高質感的數位體驗。"
  isHome={true}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-grid">

      <!-- LEFT column -->
      <div class="hero-left">
        <h1 class="hero-title">Hey There,<br />I'm <span class="highlight">Hank Chou</span></h1>
        <a href="mailto:o.d.chou@gmail.com" class="hero-email">o.d.chou@gmail.com</a>
        <div class="hero-exp">
          <span class="exp-num">10</span>
          <span class="exp-label">YEARS<br />EXPERIENCE</span>
        </div>
      </div>

      <!-- CENTER column: photo + brush stroke -->
      <div class="hero-center">
        <div class="hero-photo-wrap">
          <svg class="brush-stroke" viewBox="0 0 480 480" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M80 320 C60 200, 120 80, 240 60 C360 40, 440 140, 420 280 C400 400, 300 460, 180 440 C100 428, 90 380, 80 320 Z" fill="#1B4D4E" opacity="0.88"/>
            <path d="M320 100 C380 80, 460 160, 440 260 C420 340, 360 400, 300 380 C380 300, 400 200, 320 100 Z" fill="#1B4D4E" opacity="0.55"/>
          </svg>
          <img
            src={`${base}images/hank.jpeg`}
            alt="Hank Chou — Web Designer & Developer"
            class="hero-photo"
          />
        </div>
      </div>

      <!-- RIGHT column -->
      <div class="hero-right">
        <p class="hero-tagline">我設計讓人喜愛的網站，<br />幫助品牌建立數位競爭力。</p>
        <div class="hero-cert">
          <div class="cert-icon">✦</div>
          <p class="cert-text">專業網站設計<br />& 前端開發</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Services Section -->
  <section class="services section" style="background-color: var(--color-card-bg);">
    <div class="container">
      <div class="services-grid">
        <div class="services-list">
          {services.map(({ icon, label, count }) => (
            <div class="service-item">
              <span class="service-icon">{icon}</span>
              <div>
                <p class="service-label">{label}</p>
                <p class="service-count">{count}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="services-copy">
          <h2>What do I help?</h2>
          <p>
            我協助您找到解決方案，透過設計思維打造數位產品。無論是品牌網站、電商平台還是行動應用，都能提供從設計到上線的完整服務。
          </p>
          <div class="services-stats">
            <div>
              <span class="stat-number">50+</span>
              <span class="stat-label">完成專案</span>
            </div>
            <div>
              <span class="stat-number">30+</span>
              <span class="stat-label">滿意客戶</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Works Section -->
  {featuredWorks.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>My Latest Works</h2>
          <a href={`${base}works`} class="explore-link">Explore More Works →</a>
        </div>
        <p style="color: var(--color-text-muted); margin-bottom: var(--space-8);">
          數位體驗的完美解決方案
        </p>
        <div class="card-grid">
          {featuredWorks.map((work) => (
            <WorkCard
              title={work.data.title}
              coverImage={work.data.coverImage}
              description={work.data.description}
              tags={work.data.tags}
              slug={work.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials Section -->
  <section class="testimonials section" style="background-color: var(--color-card-bg);">
    <div class="container">
      <h2 class="section-title">People talk about us</h2>
      <p class="section-subtitle">客戶的反饋是我們最大的動力</p>
      <div class="testimonials-grid">
        {testimonials.map(({ quote, name, title }) => (
          <div class="testimonial-card">
            <p class="testimonial-quote">"{quote}"</p>
            <p class="testimonial-name">{name}</p>
            <p class="testimonial-title">{title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta section">
    <div class="container cta-inner">
      <div>
        <h2>Let's make something<br />amazing together.</h2>
        <p class="cta-sub">Start by <a href="mailto:o.d.chou@gmail.com" class="cta-link">saying hi</a></p>
      </div>
      <div class="cta-info">
        <p><strong>Information</strong></p>
        <p style="color: var(--color-text-muted);">o.d.chou@gmail.com</p>
        <nav>
          <ul class="cta-links">
            <li><a href={`${base}works`}>Works</a></li>
            <li><a href={`${base}blog`}>Blog</a></li>
            <li><a href={`${base}about`}>About</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    background-color: var(--color-bg);
    padding: var(--space-16) 0 var(--space-12);
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  /* Left */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-title {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
  }

  .highlight { color: var(--color-accent-teal); }

  .hero-email {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent-orange);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .hero-email:hover { opacity: 0.75; }

  .hero-exp {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: auto;
  }

  .exp-num {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1;
  }

  .exp-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Center */
  .hero-center {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-photo-wrap {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3/4;
  }

  .brush-stroke {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-photo {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 85%;
    height: 95%;
    object-fit: cover;
    object-position: top center;
    border-radius: 2px;
    z-index: 1;
  }

  /* Right */
  .hero-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: flex-start;
  }

  .hero-tagline {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin: 0;
  }

  .hero-cert {
    border: 2px solid var(--color-border);
    border-radius: 50%;
    width: 130px;
    height: 130px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .cert-icon {
    font-size: 1.5rem;
    color: var(--color-accent-teal);
  }

  .cert-text {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: center;
    color: var(--color-text);
    line-height: 1.5;
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .service-icon { font-size: 1.5rem; }
  .service-label { font-weight: 700; margin: 0; }
  .service-count { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }

  .services-copy h2 { margin-bottom: var(--space-4); }
  .services-copy p { color: var(--color-text-muted); }

  .services-stats {
    display: flex;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent-orange);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .explore-link {
    color: var(--color-accent-orange);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    margin-top: calc(-1 * var(--space-8));
  }

  .testimonials-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  .testimonial-card {
    background-color: var(--color-bg);
    border-radius: 0.75rem;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
  }

  .testimonial-quote {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .testimonial-name { font-weight: 700; margin: 0; }
  .testimonial-title { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }

  .cta { background-color: var(--color-bg); }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-16);
    align-items: center;
  }

  .cta-inner h2 { margin-bottom: var(--space-4); }

  .cta-sub { font-size: 1.25rem; color: var(--color-text-muted); }

  .cta-link {
    color: var(--color-accent-orange);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cta-links {
    list-style: none;
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cta-links a {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 600;
    transition: color 0.2s;
  }

  .cta-links a:hover { color: var(--color-accent-orange); }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      min-height: auto;
    }
    .hero-center { order: -1; }
    .hero-photo-wrap { max-width: 300px; margin: 0 auto; }
    .hero-right { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .hero-cert { width: 100px; height: 100px; }
  }

  @media (max-width: 640px) {
    .services-grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .cta-inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  @media (min-width: 768px) {
    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1280px) {
    .testimonials-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
