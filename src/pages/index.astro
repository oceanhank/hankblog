---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { testimonials } from '../data/testimonials';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const pathname = Astro.url.pathname;

const ctaLinks = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}works`, label: 'Works' },
  { href: `${base}blog`, label: 'Blog' },
  { href: `${base}about`, label: 'About' },
];

function isCtaActive(href: string): boolean {
  if (href === base || href === `${base}/`) {
    return pathname === base || pathname === `${base}/`;
  }
  return pathname.startsWith(href);
}

const allWorks = await getCollection('works', ({ data }) => !data.draft);
const featuredWorks = allWorks
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const services = [
  { icon: '🖥', label: '網站設計', count: '30+ 專案', color: '#1B4D4E' },
  { icon: '📱', label: '行動 App 設計', count: '15+ 專案', color: '#D4A843' },
  { icon: '✦', label: '品牌識別設計', count: '20+ 專案', color: '#E05A2B' },
];
---

<BaseLayout
  title="Hank Chou — Web Designer & Developer"
  description="我是 Hank Chou，專注於網站設計與開發，幫助品牌打造高質感的數位體驗。"
  isHome={true}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-grid">

      <!-- LEFT column -->
      <div class="hero-left">
        <h1 class="hero-title">Hey There,<br />I'm <span class="highlight">Hank</span></h1>
        <p class="hero-tagline-left">我設計讓人喜愛的網站，<br />幫助品牌建立數位競爭力。</p>
        <a href="mailto:o.d.chou@gmail.com" class="hero-cta-btn">開始合作 →</a>
      </div>

      <!-- CENTER column: photo -->
      <div class="hero-center">
        <div class="hero-photo-wrap">
          <img
            src={`${base}images/hank-cutout.png`}
            alt="Hank Chou — Web Designer & Developer"
            class="hero-photo"
          />
        </div>
      </div>

      <!-- RIGHT column -->
      <div class="hero-right">
        <div class="hero-card">
          <p class="hero-card-eyebrow">Creative Professional</p>
          <h2 class="hero-card-title">Web<br /><em>Designer</em><br /><span class="hero-card-sub">& Developer</span></h2>
          <div class="hero-card-stats">
            <div class="hero-card-stat">
              <strong class="hcs-num">50<span class="hcs-plus">+</span></strong>
              <span class="hcs-label">完成專案</span>
            </div>
            <div class="hero-card-stat">
              <strong class="hcs-num">30<span class="hcs-plus">+</span></strong>
              <span class="hcs-label">滿意客戶</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Services Section -->
  <section class="services section" style="background-color: var(--color-card-bg);">
    <div class="container">
      <div class="services-grid">
        <div class="services-list">
          {services.map(({ color, label, count }) => (
            <div class="service-item">
              <div class="service-icon-wrap" style={`background-color: ${color}`}></div>
              <div class="service-text">
                <p class="service-label">{label}</p>
                <p class="service-count">{count}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="services-copy">
          <h2>What do I help?</h2>
          <p>
            我協助您找到解決方案，透過設計思維打造數位產品。無論是品牌網站、電商平台還是行動應用，都能提供從設計到上線的完整服務。
          </p>
          <div class="services-stats">
            <div>
              <span class="stat-number">50+</span>
              <span class="stat-label">完成專案</span>
            </div>
            <div>
              <span class="stat-number">30+</span>
              <span class="stat-label">滿意客戶</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Works Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>My Latest Works</h2>
      </div>
      <div class="wip-block">
        <span class="wip-icon">🚧</span>
        <p class="wip-title">施工中</p>
        <p class="wip-desc">作品集正在整理中，敬請期待。</p>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials section" style="background-color: var(--color-card-bg);">
    <div class="container">
      <h2 class="section-title">People talk about us</h2>
      <div class="wip-block">
        <span class="wip-icon">🚧</span>
        <p class="wip-title">施工中</p>
        <p class="wip-desc">客戶見證正在收集中，敬請期待。</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta section">
    <div class="container cta-inner">
      <div>
        <h2>Let's make something<br />amazing together.</h2>
        <p class="cta-sub">Start by <a href="mailto:o.d.chou@gmail.com" class="cta-link">saying hi</a></p>
      </div>
      <div class="cta-info">
        <p class="cta-info-title">Information</p>
        <p class="cta-info-email">o.d.chou@gmail.com</p>
        <nav>
          <ul class="cta-links">
            {ctaLinks.map(({ href, label }) => (
              <li>
                <a href={href} class:list={['cta-link-item', { active: isCtaActive(href) }]}>
                  <span class="cta-paren cta-paren-l">(</span>
                  <span>{label}</span>
                  <span class="cta-paren cta-paren-r">)</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    background-color: var(--color-bg);
    padding: var(--space-16) 0 var(--space-12);
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  /* Left */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-title {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
  }

  .highlight { color: var(--color-accent-teal); }

  .hero-tagline-left {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin: 0;
  }

  .hero-cta-btn {
    display: inline-block;
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: 0.6rem 1.4rem;
    background-color: var(--color-accent-orange);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 2rem;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .hero-cta-btn:hover { opacity: 0.85; }

  /* Center */
  .hero-center {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-photo-wrap {
    width: 100%;
    max-width: 460px;
  }

  .hero-photo {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Right */
  .hero-right {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: 2rem 2rem 2rem 1.75rem;
    border-left: 2px solid var(--color-accent-teal);
  }

  .hero-card-eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
    margin: 0;
  }

  .hero-card-title {
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
    font-style: normal;
  }

  .hero-card-title em {
    font-style: italic;
    color: var(--color-accent-teal);
    font-weight: 800;
  }

  .hero-card-sub {
    font-size: 0.9em;
    font-weight: 600;
    color: var(--color-text-muted);
    font-style: normal;
    letter-spacing: 0.02em;
  }

  .hero-card-stats {
    display: flex;
    gap: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .hero-card-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hcs-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent-orange);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hcs-plus {
    font-size: 1.2rem;
  }

  .hcs-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
    align-items: center;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    width: 100%;
  }

  .service-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .service-text { display: flex; flex-direction: column; gap: 4px; }
  .service-label { font-weight: 700; font-size: 1.15rem; margin: 0; color: var(--color-text); }
  .service-count { font-size: 0.88rem; color: var(--color-text-muted); margin: 0; }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 67%;
    margin: 0 auto;
  }

  .services-copy h2 { margin-bottom: var(--space-4); }
  .services-copy p { color: var(--color-text-muted); }

  .services-stats {
    display: flex;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent-orange);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .wip-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-16) 0;
    border: 1.5px dashed var(--color-border);
    border-radius: 1rem;
    text-align: center;
  }

  .wip-icon { font-size: 2.5rem; }

  .wip-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .wip-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .explore-link {
    color: var(--color-accent-orange);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    margin-top: calc(-1 * var(--space-8));
  }

  .testimonials-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  .testimonial-card {
    background-color: var(--color-bg);
    border-radius: 0.75rem;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
  }

  .testimonial-quote {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .testimonial-name { font-weight: 700; margin: 0; }
  .testimonial-title { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }

  .cta { background-color: var(--color-bg); }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .cta-inner h2 { margin-bottom: var(--space-4); }

  .cta-sub { font-size: 1.25rem; color: var(--color-text-muted); }

  .cta-link {
    color: var(--color-accent-orange);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cta-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    justify-self: center;
  }

  .cta-info-title {
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 var(--space-2);
  }

  .cta-info-email {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  .cta-links {
    list-style: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .cta-link-item {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .cta-paren {
    font-size: 1rem;
    font-weight: 400;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }

  .cta-paren-l { transform: translateX(6px); }
  .cta-paren-r { transform: translateX(-6px); }

  .cta-link-item:hover .cta-paren,
  .cta-link-item.active .cta-paren {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      min-height: auto;
    }
    .hero-center { order: -1; }
    .hero-photo-wrap { max-width: 300px; margin: 0 auto; }
    .hero-right { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .hero-cert { width: 100px; height: 100px; }
  }

  @media (max-width: 640px) {
    .services-grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .cta-inner { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  @media (min-width: 768px) {
    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1280px) {
    .testimonials-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
