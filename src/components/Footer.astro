---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-copy">&copy;{year} Hank Chou. All Rights Reserved.</p>
    <p class="footer-credit">Design by <span class="footer-name">Hank Chou</span></p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8) 0;
    margin-top: var(--space-16);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copy {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0;
  }

  .footer-credit {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-name {
    color: #1B4D4E;
    font-weight: 700;
  }
</style>
