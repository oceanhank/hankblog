---
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const pathname = Astro.url.pathname;

const links = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}works`, label: 'Works' },
  { href: `${base}blog`, label: 'Blog' },
  { href: `${base}about`, label: 'About' },
];

function isActive(href: string): boolean {
  if (href === base || href === `${base}/`) {
    return pathname === base || pathname === `${base}/`;
  }
  return pathname.startsWith(href);
}
---

<nav class="nav">
  <div class="container nav-inner">

    <!-- Logo -->
    <a href={base} class="nav-logo">
      <img src={`${base}images/logo-hank.png`} alt="Hank Chou" class="nav-logo-img" />
    </a>

    <!-- Centre links -->
    <ul class="nav-links" id="nav-menu">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['nav-link', { active: isActive(href) }]}>
            <span class="paren paren-l">(</span>
            <span class="link-label">{label}</span>
            <span class="paren paren-r">)</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Right: hamburger only -->
    <div class="nav-right">
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>
</nav>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const menu = document.getElementById('nav-menu');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('open');
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 7rem;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .nav-logo-img {
    height: 100px;
    width: auto;
    display: block;
  }

  /* Centre links */
  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--space-8);
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  /* Parentheses */
  .paren {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }

  .paren-l { transform: translateX(6px); }
  .paren-r { transform: translateX(-6px); }

  .nav-link:hover .paren,
  .nav-link.active .paren {
    opacity: 1;
    transform: translateX(0);
  }


  /* Right */
  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
  }

  @media (max-width: 768px) {
    .nav-inner {
      grid-template-columns: 1fr auto;
    }

    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 7rem;
      left: 0;
      right: 0;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-4) var(--space-6);
      gap: var(--space-4);
    }

    .nav-links.open { display: flex; }
  }
</style>
