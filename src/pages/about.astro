---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';

const services = [
  { title: '網站設計與開發', desc: '從品牌識別到上線，提供完整的網站設計與前端開發服務，確保視覺美感與效能兼顧。' },
  { title: '電商平台建置', desc: '打造轉換率優先的電商網站，整合金流、庫存管理與行銷工具。' },
  { title: '品牌識別設計', desc: '幫助新創與中小企業建立一致的品牌視覺系統，從 Logo 到完整設計指南。' },
  { title: 'SEO 優化', desc: '透過技術 SEO 與內容策略，提升搜尋排名，吸引更多自然流量。' },
];
---

<BaseLayout
  title="About"
  description="認識 Hank Chou — 擁有 10 年經驗的網站設計師與開發者，專注於打造高質感的數位體驗。"
>
  <section class="container" style="padding-top: var(--space-16); padding-bottom: var(--space-16); max-width: 800px;">
    <h1 style="margin-bottom: var(--space-8);">About Me</h1>

    <!-- Personal Intro -->
    <div style="margin-bottom: var(--space-12);">
      <p style="font-size: 1.125rem; line-height: 1.8; margin-bottom: var(--space-4);">
        嗨，我是 <strong>Hank Chou</strong>，一位擁有超過 10 年經驗的網站設計師與前端開發者。
      </p>
      <p style="color: var(--color-text-muted); line-height: 1.8; margin-bottom: var(--space-4);">
        我熱愛將複雜的問題簡化為優雅的設計，專注於用戶體驗與視覺美感的結合。過去曾協助各類型企業——從新創到傳統產業——建立數位形象，打造真正對業務有幫助的網站。
      </p>
      <p style="color: var(--color-text-muted); line-height: 1.8;">
        工作之餘，我透過這個部落格分享設計與開發的實務心得，希望能幫助更多人在數位世界中脫穎而出。
      </p>
    </div>

    <!-- Services -->
    <div style="margin-bottom: var(--space-12);">
      <h2 style="margin-bottom: var(--space-8);">我能幫你做什麼</h2>
      <div class="services-grid">
        {services.map(({ title, desc }) => (
          <div class="service-card">
            <h3 style="margin-bottom: var(--space-3); font-size: 1.1rem;">{title}</h3>
            <p style="color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.7; margin: 0;">{desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact -->
    <div class="contact-box">
      <h2 style="margin-bottom: var(--space-4);">聯絡我</h2>
      <p style="color: var(--color-text-muted); margin-bottom: var(--space-6);">
        有專案想討論？加我的 Line 官方帳號，我通常在 1-2 個工作天內回覆。
      </p>
      <a href="https://lin.ee/OicLcFQ" target="_blank" rel="noopener" class="line-btn">
        <svg class="line-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
        </svg>
        透過 Line 聯絡我
      </a>
    </div>
  </section>
  <CtaSection />
</BaseLayout>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .service-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--space-6);
  }

  .contact-box {
    background-color: var(--color-accent-teal);
    border-radius: 0.75rem;
    padding: var(--space-8);
    color: #fff;
  }

  .contact-box h2 { color: #fff; }

  .contact-box p { color: #C8E6E6; }

  .line-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.6rem;
    background-color: #06C755;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 2rem;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }

  .line-btn:hover { opacity: 0.88; }

  .line-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
